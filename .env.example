# ── Monarch Admin · environment ──────────────────────────────────────────────
# Copy to .env.local for development. On Vercel, add these as Environment
# Variables (Project → Settings → Environment Variables).

# Public: safe to ship to the browser. Every table is protected by row-level
# security, so these keys alone grant nothing.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy anon key as NEXT_PUBLIC_SUPABASE_ANON_KEY

# Server only — never prefixed with NEXT_PUBLIC_, never in client code.
# Used solely by app/api/team/invite to send invitation emails.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                    # or the legacy service_role JWT

# Where invitation links should land (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=https://admin.yourdomain.com

# Server only — Bob, the site assistant. Every AI request runs in /api/bob on
# the server with this key; the browser never sees it and never talks to the
# provider. Without it Bob says he is not configured (the rest of the app works).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Bob's model and effort (defaults: claude-opus-5, medium). The
# company can also set bob.model / bob.dailyTurnCap in companies.settings.
# BOB_MODEL=claude-opus-5
# BOB_EFFORT=medium
